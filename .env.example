# ===========================================
# Swiftlet Backend Environment Configuration
# ===========================================

# Server
PORT=8080
ENV=development
LOG_LEVEL=debug
DEBUG=true

# Database (PostgreSQL + TimescaleDB)
POSTGRES_DSN=host=localhost user=swiftlet password=swiftlet123 dbname=swiftlet port=5432 sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=swiftlet
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# MQTT Broker
MQTT_BROKER=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=swiftlet-backend
MQTT_TOPIC_PREFIX=swiftlead/tel
MQTT_KEEPALIVE=30
MQTT_CONNECT_TIMEOUT=5

# AI Engine
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT=5
AI_ENGINE_ENABLED=false

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
CORS_ALLOW_CREDENTIALS=true

# Sensor Thresholds
TEMP_HIGH_THRESHOLD=35.0
TEMP_LOW_THRESHOLD=20.0
HUMID_HIGH_THRESHOLD=85.0
HUMID_LOW_THRESHOLD=60.0
AMMONIA_HIGH_THRESHOLD=25.0
NODE_OFFLINE_THRESHOLD_MINUTES=15
SENSOR_DATA_RETENTION_DAYS=365

# File Uploads
MAX_UPLOAD_SIZE_MB=10
MAX_AVATAR_SIZE_MB=2
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Server Timeouts
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=15
SERVER_IDLE_TIMEOUT=60
SHUTDOWN_TIMEOUT=30
REQUEST_TIMEOUT=60
