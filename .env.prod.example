# ===========================================
# Swiftlet Backend - Production Environment
# ===========================================
# Copy this file to .env.prod and fill in values

# Application
ENVIRONMENT=production
PORT=8080
VERSION=latest

# Database (PostgreSQL + TimescaleDB in Docker Compose)
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DSN=postgres://swiftlet:${DB_PASSWORD}@db:5432/swiftlet?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# JWT Authentication (GENERATE NEW SECRET!)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_STRING_FOR_PRODUCTION
JWT_EXPIRATION_HOURS=24

# MinIO Object Storage (in Docker Compose)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=swiftlet
MINIO_USE_SSL=false

# MQTT Broker (in Docker Compose)
# For TLS: change to ssl://mosquitto:8883 and set MQTT_USE_TLS=true
MQTT_BROKER=tcp://mosquitto:1883
MQTT_CLIENT_ID=swiftlet-backend-prod
MQTT_TOPIC_TELEMETRY=swiftlead/tel/+
MQTT_USE_TLS=false
MQTT_CA_CERT=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
MQTT_SKIP_VERIFY=false

# AI Engine (optional)
AI_ENGINE_URL=http://ai-engine:5000
AI_ENGINE_ENABLED=false
AI_ENGINE_TIMEOUT=30s

# CORS
CORS_ALLOWED_ORIGINS=https://app.swiftlead.id,https://admin.swiftlead.id
CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=true

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://monitor.swiftlead.id

# Sensor Thresholds
TEMP_MIN=25.0
TEMP_MAX=32.0
HUMIDITY_MIN=70.0
HUMIDITY_MAX=90.0
AMMONIA_MAX=25.0

# File Uploads
MAX_UPLOAD_SIZE_MB=10
MAX_AVATAR_SIZE_MB=2
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Timeouts
REQUEST_TIMEOUT=30s
