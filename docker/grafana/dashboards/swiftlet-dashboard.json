{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "id": 100,
            "type": "row",
            "title": "📊 Overview",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "collapsed": false
        },
        {
            "id": 1,
            "title": "Total Requests",
            "description": "Total HTTP requests served",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "expr": "sum(swiftlet_http_requests_total)",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 2,
            "title": "🚨 Active Alerts",
            "description": "Unresolved sensor alerts",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 4,
                "y": 1
            },
            "targets": [
                {
                    "expr": "swiftlet_active_alerts",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 1
                            },
                            {
                                "color": "red",
                                "value": 5
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 3,
            "title": "📡 Nodes Online",
            "description": "Active IoT nodes",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 8,
                "y": 1
            },
            "targets": [
                {
                    "expr": "swiftlet_nodes_online",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 4,
            "title": "🔌 MQTT Status",
            "description": "Broker connection",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 12,
                "y": 1
            },
            "targets": [
                {
                    "expr": "swiftlet_mqtt_connection_status",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "❌ Offline",
                                    "color": "red"
                                },
                                "1": {
                                    "text": "✅ Online",
                                    "color": "green"
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "id": 5,
            "title": "📨 MQTT Messages",
            "description": "Sensor data received",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 16,
                "y": 1
            },
            "targets": [
                {
                    "expr": "swiftlet_mqtt_messages_received_total",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "purple",
                                "value": null
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 6,
            "title": "⚡ Goroutines",
            "description": "Active concurrent workers",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 4,
                "x": 20,
                "y": 1
            },
            "targets": [
                {
                    "expr": "go_goroutines",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "orange",
                                "value": null
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 101,
            "type": "row",
            "title": "💻 System Health",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "collapsed": false
        },
        {
            "id": 7,
            "title": "Memory Usage",
            "description": "Current heap allocation",
            "type": "gauge",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 0,
                "y": 6
            },
            "targets": [
                {
                    "expr": "go_memstats_alloc_bytes / 1024 / 1024",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "mbytes",
                    "min": 0,
                    "max": 128,
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 64
                            },
                            {
                                "color": "red",
                                "value": 96
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 8,
            "title": "Avg Response Time",
            "description": "Mean request latency",
            "type": "gauge",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 6,
                "y": 6
            },
            "targets": [
                {
                    "expr": "sum(rate(swiftlet_http_request_duration_seconds_sum[5m])) / sum(rate(swiftlet_http_request_duration_seconds_count[5m])) * 1000",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "min": 0,
                    "max": 200,
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 50
                            },
                            {
                                "color": "red",
                                "value": 100
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 9,
            "title": "MQTT Errors",
            "description": "Failed message processing",
            "type": "stat",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 12,
                "y": 6
            },
            "targets": [
                {
                    "expr": "swiftlet_mqtt_message_errors_total",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 1
                            }
                        ]
                    }
                }
            }
        },
        {
            "id": 10,
            "title": "GC Pause",
            "description": "Garbage collection latency",
            "type": "stat",
            "gridPos": {
                "h": 5,
                "w": 6,
                "x": 18,
                "y": 6
            },
            "targets": [
                {
                    "expr": "go_gc_duration_seconds{quantile=\"0.5\"} * 1000",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "decimals": 2
                }
            }
        },
        {
            "id": 102,
            "type": "row",
            "title": "📈 Traffic",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 11
            },
            "collapsed": false
        },
        {
            "id": 11,
            "title": "Request Rate (per minute)",
            "description": "HTTP requests over time",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 12
            },
            "targets": [
                {
                    "expr": "sum(rate(swiftlet_http_requests_total[1m])) * 60",
                    "legendFormat": "Requests/min",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "fillOpacity": 20
                    }
                }
            }
        },
        {
            "id": 12,
            "title": "Memory Trend",
            "description": "Memory allocation over time",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 12
            },
            "targets": [
                {
                    "expr": "go_memstats_alloc_bytes / 1024 / 1024",
                    "legendFormat": "Heap (MB)",
                    "refId": "A"
                },
                {
                    "expr": "go_memstats_sys_bytes / 1024 / 1024",
                    "legendFormat": "System (MB)",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "mbytes",
                    "custom": {
                        "fillOpacity": 10
                    }
                }
            }
        },
        {
            "id": 103,
            "type": "row",
            "title": "🔍 Details",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 20
            },
            "collapsed": false
        },
        {
            "id": 13,
            "title": "Response Time P99",
            "description": "99th percentile latency",
            "type": "timeseries",
            "gridPos": {
                "h": 7,
                "w": 12,
                "x": 0,
                "y": 21
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.99, sum(rate(swiftlet_http_request_duration_seconds_bucket[5m])) by (le)) * 1000",
                    "legendFormat": "P99",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "ms"
                }
            }
        },
        {
            "id": 14,
            "title": "Concurrent Workers",
            "description": "Goroutines over time",
            "type": "timeseries",
            "gridPos": {
                "h": 7,
                "w": 12,
                "x": 12,
                "y": 21
            },
            "targets": [
                {
                    "expr": "go_goroutines",
                    "legendFormat": "Goroutines",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "fillOpacity": 30
                    }
                }
            }
        },
        {
            "id": 15,
            "title": "Requests by Status",
            "type": "piechart",
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 0,
                "y": 28
            },
            "targets": [
                {
                    "expr": "sum by (status) (swiftlet_http_requests_total)",
                    "legendFormat": "{{status}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table"
                }
            }
        },
        {
            "id": 16,
            "title": "Requests by Method",
            "type": "piechart",
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 8,
                "y": 28
            },
            "targets": [
                {
                    "expr": "sum by (method) (swiftlet_http_requests_total)",
                    "legendFormat": "{{method}}",
                    "refId": "A"
                }
            ],
            "options": {
                "legend": {
                    "displayMode": "table"
                }
            }
        },
        {
            "id": 17,
            "title": "Top Endpoints",
            "type": "bargauge",
            "gridPos": {
                "h": 7,
                "w": 8,
                "x": 16,
                "y": 28
            },
            "targets": [
                {
                    "expr": "topk(5, sum by (path) (swiftlet_http_requests_total))",
                    "legendFormat": "{{path}}",
                    "refId": "A"
                }
            ],
            "options": {
                "orientation": "horizontal"
            }
        }
    ],
    "refresh": "10s",
    "schemaVersion": 38,
    "style": "dark",
    "tags": [
        "swiftlet",
        "iot",
        "monitoring"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    },
